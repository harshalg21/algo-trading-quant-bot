# DhanHQ API Configuration (Free)
DHAN_CLIENT_ID="your_dhan_client_id"
DHAN_ACCESS_TOKEN="your_dhan_access_token"

# Fyers API Configuration (Free Alternative)
FYERS_APP_ID="your_fyers_app_id"
FYERS_ACCESS_TOKEN="your_fyers_access_token"

# Telegram Bot Notifications (Semi-Automated Approval)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Trading Capital & Risk Settings
ACCOUNT_EQUITY=100000.0  # Initial account balance in INR
MAX_RISK_PER_TRADE_PCT=1.0  # 1% risk per trade
MAX_DAILY_DRAWDOWN_PCT=3.0  # 3% daily circuit breaker
MAX_OPEN_POSITIONS=5

# Mode: PAPER or LIVE
TRADING_MODE="PAPER"
